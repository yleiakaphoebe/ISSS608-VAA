      <table>
        <view>
          <datasources>
            <datasource caption='Orders (Superstore)' name='federated.1otpijm17v5zcd1a76bv41rmgaqy' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='# of Std Dev' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <range max='3' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1otpijm17v5zcd1a76bv41rmgaqy'>
            <column caption='Upper Control Limit' datatype='real' name='[Calculation_2475837358026752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(SUM([Sales])) + WINDOW_STDEV(SUM([Sales]))*[Parameters].[Parameter 1]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column caption='Lower Control Limit' datatype='real' name='[Upper Control Limit (copy)_2475837359423489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(SUM([Sales])) - WINDOW_STDEV(SUM([Sales]))*[Parameters].[Parameter 1]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Out of Control Limit' datatype='real' name='[Upper Control Limit (copy)_2475837362315266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Sales]) &gt; [Calculation_2475837358026752]&#13;&#10;OR SUM([Sales]) &lt; [Upper Control Limit (copy)_2475837359423489]&#13;&#10;THEN SUM([Sales])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Sales]' derivation='Sum' name='[sum:Sales:qk]' pivot='key' type='quantitative' />
